<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="001-schools" author="founder">

		<createTable tableName="schools">
			<column name="id" type="BIGSERIAL">
				<constraints primaryKey="true" nullable="false" />
			</column>
			<column name="school_code" type="VARCHAR(50)">
				<constraints nullable="false" unique="true" />
			</column>
			<column name="name" type="VARCHAR(255)" />
			<column name="district" type="VARCHAR(100)" />
			<column name="block" type="VARCHAR(100)" />
			<column name="state" type="VARCHAR(100)" />
			<column name="address" type="TEXT" />
			<column name="total_students" type="INT" />
			<column name="is_active" type="BOOLEAN"
				defaultValueBoolean="true" />
			<column name="created_at" type="TIMESTAMP"
				defaultValueComputed="CURRENT_TIMESTAMP" />
		</createTable>
	</changeSet>
</databaseChangeLog>
