<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
   
   
     <changeSet id="003-meal-uploads" author="founder">

        <createTable tableName="meal_uploads">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>

            <column name="school_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="upload_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="kitchen_image_url" type="TEXT"/>
            <column name="food_image_url" type="TEXT"/>
            <column name="group_image_url" type="TEXT"/>

            <column name="uploaded_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="upload_time" type="TIMESTAMPTZ"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)"
                    defaultValue="RECEIVED">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- One upload per school per day -->
        <addUniqueConstraint
                tableName="meal_uploads"
                columnNames="school_id, upload_date"
                constraintName="uk_meal_uploads_school_date"/>

        <!-- FK: meal_uploads.school_id → schools.id -->
        <addForeignKeyConstraint
                constraintName="fk_meal_uploads_school"
                baseTableName="meal_uploads"
                baseColumnNames="school_id"
                referencedTableName="schools"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

    </changeSet>

</databaseChangeLog>